---
// VLibras — tradutor de Libras (widget oficial do governo federal).
// Fica no canto inferior direito; a barra de acessibilidade fica à esquerda.
---
<div vw class="enabled">
  <div vw-access-button class="active"></div>
  <div vw-plugin-wrapper>
    <div class="vw-plugin-top-wrapper"></div>
  </div>
</div>
<script is:inline src="https://vlibras.gov.br/app/vlibras-plugin.js"></script>
<script is:inline>
  new window.VLibras.Widget('https://vlibras.gov.br/app');
</script>
