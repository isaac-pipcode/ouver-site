---
// Hero — bloco de abertura com fundo escuro, título + subtítulo + CTAs.
interface CTA { rotulo: string; href: string; primario?: boolean; }
interface Props { titulo: string; subtitulo: string; ctas?: CTA[]; }
const { titulo, subtitulo, ctas = [] } = Astro.props;
---
<section class="hero">
  <div class="hero-content">
    <h1>{titulo}</h1>
    <p>{subtitulo}</p>
    {ctas.length > 0 && (
      <div class="hero-ctas">
        {ctas.map((cta) => (
          <a href={cta.href} class={cta.primario ? 'botao botao-primario' : 'botao botao-secundario'}>
            {cta.rotulo}
          </a>
        ))}
      </div>
    )}
  </div>
</section>