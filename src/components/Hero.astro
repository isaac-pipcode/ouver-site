---
// Hero — bloco de abertura. Opcionalmente exibe uma mídia (vídeo do banner)
// como "tela" no topo, seguida de título + subtítulo + CTAs.
interface CTA { rotulo: string; href: string; primario?: boolean; }
interface Props {
  titulo: string;
  subtitulo: string;
  ctas?: CTA[];
  video?: string;      // ex.: /videos/banner-ouver.mp4
  poster?: string;     // imagem estática exibida com prefers-reduced-motion
  videoRotulo?: string; // descrição textual da mídia (para leitores de tela)
}
const { titulo, subtitulo, ctas = [], video, poster, videoRotulo } = Astro.props;
---
<section class={`hero${video ? ' hero--midia' : ''}`}>
  {video && (
    <div class="hero-midia">
      <video
        autoplay muted loop playsinline
        preload="auto"
        poster={poster}
        aria-label={videoRotulo}
        role="img"
      >
        <source src={video} type="video/mp4" />
      </video>
      {poster && <img class="hero-midia-poster" src={poster} alt={videoRotulo || ''} />}
    </div>
  )}

  <div class="hero-content">
    <h1>{titulo}</h1>
    <p>{subtitulo}</p>
    {ctas.length > 0 && (
      <div class="hero-ctas">
        {ctas.map((cta) => (
          <a href={cta.href} class={cta.primario ? 'botao botao-primario' : 'botao botao-secundario'}>
            {cta.rotulo}
          </a>
        ))}
      </div>
    )}
  </div>
</section>
