---
// CardSolucao — cartão de macroárea com numeração, título, descrição e link.
// A numeração em mono substitui ícones: mais sóbrio e alinhado à marca.
interface Props { titulo: string; descricao: string; href: string; numero?: string; }
const { titulo, descricao, href, numero } = Astro.props;
---
<article class="card-solucao">
  {numero && <span class="card-solucao-numero" aria-hidden="true">{numero}</span>}
  <h3><a href={href}>{titulo}</a></h3>
  <p>{descricao}</p>
  <a href={href} class="card-link">Saber mais<span class="visualmente-oculto"> sobre {titulo}</span></a>
</article>
