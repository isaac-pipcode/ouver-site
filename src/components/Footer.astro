  // Preencher com os perfis REAIS da Ouver. Remover os que não existirem.
  // { rotulo: 'Instagram', href: 'https://instagram.com/...' },
];
---
<footer>
  <p>Ouver Acessibilidade — acessibilidade audiovisual</p>
