---
// Footer — grid com navegação, contato e declaração de acessibilidade.
const navegacao = [
  { rotulo: 'Quem somos', href: '/quem-somos' },
  { rotulo: 'Soluções', href: '/solucoes' },
  { rotulo: 'Portfólio', href: '/portfolio' },
  { rotulo: 'Orçamento', href: '/orcamento' },
  { rotulo: 'Contato', href: '/contato' },
];
---
<footer class="site-footer">
  <div class="site-footer-inner">
    <div>
      <img class="footer-logo" src="/ouver-assinatura-horizontal.svg" alt="Ouver — Audiovisual e Acessibilidade" height="40" />
      <p class="footer-tag">Audiovisual e Acessibilidade</p>
      <p>Acessibilidade audiovisual para que ninguém fique de fora.</p>
    </div>
    <div>
      <h4>Páginas</h4>
      <ul>
        {navegacao.map((item) => (
          <li><a href={item.href}>{item.rotulo}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h4>Contato</h4>
      <ul>
        <li><a href="mailto:ouveracessibilidade@gmail.com">ouveracessibilidade@gmail.com</a></li>
        <li><a href="https://wa.me/5521996279728">WhatsApp (RJ): (21) 99627-9728</a></li>
        <li><a href="https://wa.me/5585982297179">WhatsApp (CE): (85) 98229-7179</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <p><a href="/acessibilidade">Declaração de acessibilidade</a></p>
    <p>&copy; {new Date().getFullYear()} Ouver Acessibilidade</p>
  </div>
</footer>
