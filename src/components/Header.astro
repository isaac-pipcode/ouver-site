---
// Header com símbolo Ouver + navegação.
// `sobreHero`: quando true (home), o header fica transparente sobre o hero escuro
// e vira sólido ao rolar — criando um canvas escuro contínuo no topo.
interface Props { sobreHero?: boolean; }
const { sobreHero = false } = Astro.props;

const navegacao = [
  { rotulo: 'Início', href: '/' },
  { rotulo: 'Quem somos', href: '/quem-somos' },
  { rotulo: 'Soluções', href: '/solucoes' },
  { rotulo: 'Portfólio', href: '/portfolio' },
  { rotulo: 'Orçamento', href: '/orcamento' },
];
---
<header class={`site-header${sobreHero ? ' site-header--sobre' : ''}`} data-sobre-hero={sobreHero ? 'true' : undefined}>
  <nav>
    <a href="/" class="logo" aria-label="Ouver Audiovisual e Acessibilidade, página inicial">
      {sobreHero ? (
        <>
          <img class="logo-claro" src="/ouver-simbolo-negativo.svg" alt="" width="48" height="48" aria-hidden="true" />
          <img class="logo-escuro" src="/ouver-simbolo.svg" alt="" width="48" height="48" aria-hidden="true" />
        </>
      ) : (
        <img src="/ouver-simbolo.svg" alt="" width="48" height="48" aria-hidden="true" />
      )}
    </a>

    <button class="menu-toggle" aria-label="Abrir menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>

    <ul class="nav-links">
      {navegacao.map((item) => (
        <li>
          <a href={item.href} aria-current={Astro.url.pathname === item.href ? 'page' : undefined}>
            {item.rotulo}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector('.menu-toggle');
  const nav = document.querySelector('.nav-links');
  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const expanded = nav.classList.toggle('active');
      toggle.setAttribute('aria-expanded', String(expanded));
    });
  }

  // Header sólido depois que sai do hero (só quando ele nasce transparente).
  const header = document.querySelector('.site-header[data-sobre-hero="true"]');
  if (header) {
    const aoRolar = () => header.classList.toggle('site-header--solido', window.scrollY > 60);
    aoRolar();
    window.addEventListener('scroll', aoRolar, { passive: true });
  }
</script>
