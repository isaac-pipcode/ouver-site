---
// Header com símbolo Ouver (SVG) + wordmark + navegação.
const navegacao = [
  { rotulo: 'Início', href: '/' },
  { rotulo: 'Quem somos', href: '/quem-somos' },
  { rotulo: 'Soluções', href: '/solucoes' },
  { rotulo: 'Portfólio', href: '/portfolio' },
  { rotulo: 'Orçamento', href: '/orcamento' },
];
const isHome = Astro.url.pathname === '/';
---
<header class="site-header">
  <nav>
    <a href="/" class="logo" aria-label="Ouver Acessibilidade, página inicial">
      <img src="/ouver-simbolo.svg" alt="" width="96" height="48" style="height:2.25rem;width:auto;" aria-hidden="true" />
      <span class="logo-word">ouver</span>
    </a>

    <button class="menu-toggle" aria-label="Abrir menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>

    <ul class="nav-links">
      {navegacao.map((item) => (
        <li>
          <a href={item.href} aria-current={Astro.url.pathname === item.href ? 'page' : undefined}>
            {item.rotulo}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector('.menu-toggle');
  const nav = document.querySelector('.nav-links');
  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const expanded = nav.classList.toggle('active');
      toggle.setAttribute('aria-expanded', String(expanded));
    });
  }
</script>