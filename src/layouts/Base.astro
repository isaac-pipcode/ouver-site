---
// Base — layout com fontes e favicon da marca Ouver.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import Acessibilidade from '../components/Acessibilidade.astro';

interface Props { titulo: string; descricao: string; sobreHero?: boolean; semFooter?: boolean; }
const { titulo, descricao, sobreHero = false, semFooter = false } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo} — Ouver Acessibilidade</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon-claro.svg" media="(prefers-color-scheme: dark)" />
  </head>
  <body class={sobreHero ? 'tem-hero-escuro' : undefined}>
    <a href="#conteudo" class="pular-conteudo">Pular para o conteúdo</a>
    <Header sobreHero={sobreHero} />
    <main id="conteudo">
      <slot />
    </main>
    {!semFooter && <Footer />}
    <CookieBanner />
    <Acessibilidade />
  </body>
</html>