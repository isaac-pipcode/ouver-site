---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
---
<Base titulo="Contato" descricao="Fale com a Ouver por e-mail ou WhatsApp. Responderemos em até 2 dias úteis.">
  <Hero
    titulo="Contato"
    subtitulo="Fale com a gente. Responderemos em até 2 dias úteis."
  />

  <section class="secao secao-alt" aria-labelledby="canais">
    <div class="section-heading">
      <h2 id="canais">Canais de atendimento</h2>
    </div>
    <ul class="lista-valores">
      <li>
        <strong>E-mail:</strong>{' '}
        <a href="mailto:ouveracessibilidade@gmail.com">ouveracessibilidade@gmail.com</a>
      </li>
      <li>
        <strong>WhatsApp (Rio de Janeiro):</strong>{' '}
        <a href="https://wa.me/5521996279728">(21) 99627-9728</a>
      </li>
      <li>
        <strong>WhatsApp (Ceará):</strong>{' '}
        <a href="https://wa.me/5585982297179">(85) 98229-7179</a>
      </li>
    </ul>
  </section>

  <section class="secao-conversao" aria-labelledby="orcamento-cta">
    <h2 id="orcamento-cta">Prefere um orçamento?</h2>
    <p>Se você já sabe o que precisa, solicite um orçamento direto pelo formulário.</p>
    <a href="/orcamento" class="botao botao-primario">Solicitar orçamento</a>
  </section>
</Base>
