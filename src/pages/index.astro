---
// Home — uma única tela (sem rolagem): o vídeo da marca centralizado no escuro.
import Base from '../layouts/Base.astro';

const videoDescricao =
  'Animação da marca Ouver: o símbolo — um quadro aberto com uma onda sonora de nove barras — se desenha; em seguida aparece o nome "ouver" e, abaixo, a assinatura "Audiovisual e Acessibilidade".';
---
<Base
  titulo="Acessibilidade Audiovisual para ver e ouvir"
  descricao="A Ouver torna filmes, séries, eventos e conteúdos acessíveis a pessoas com deficiência visual e auditiva."
  sobreHero
  semFooter
>
  <section class="tela-video" aria-label="Abertura da Ouver">
    <h1 class="visualmente-oculto">Acessibilidade Audiovisual para ver e ouvir</h1>

    <div class="tela-video-central">
      <video
        autoplay muted loop playsinline
        preload="auto"
        poster="/videos/banner-ouver-escuro-poster.jpg"
        aria-label={videoDescricao}
        role="img"
      >
        <source src="/videos/banner-ouver-escuro.mp4" type="video/mp4" />
      </video>
      <img
        class="tela-video-poster"
        src="/videos/banner-ouver-escuro-poster.jpg"
        alt={videoDescricao}
      />
    </div>
  </section>
</Base>
