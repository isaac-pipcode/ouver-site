---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { getCollection } from 'astro:content';

const projetos = await getCollection('portfolio');
projetos.sort((a, b) => {
  if (a.data.categoria !== b.data.categoria) return a.data.categoria.localeCompare(b.data.categoria);
  return a.data.titulo.localeCompare(b.data.titulo);
});

// Group projects by category
const categorias: Record<string, { label: string; items: typeof projetos }> = {};
for (const p of projetos) {
  const cat = p.data.categoria || 'audiovisuais';
  if (!categorias[cat]) categorias[cat] = { label: getCategoryLabel(cat), items: [] };
  categorias[cat].items.push(p);
}

function getCategoryLabel(cat: string): string {
  const labels: Record<string, string> = {
    'audiovisuais': 'Audiovisual',
    'educacionais': 'Educacionais',
    'exposicoes': 'Exposições',
    'audiolivros': 'Audiolivros',
    'mostras': 'Mostras',
  };
  return labels[cat] || cat;
}

// Esconde valores ainda não preenchidos (placeholders entre colchetes)
function isPlaceholder(v?: string): boolean {
  return !v || v.trim().startsWith('[');
}
---
<Base titulo="Portfólio" descricao="Conheça os projetos de acessibilidade audiovisual realizados pela Ouver — filmes, séries, exposições, materiais educativos e mais.">
  <Hero
    titulo="Portfólio"
    subtitulo="Uma seleção dos trabalhos que desenvolvemos no campo da acessibilidade audiovisual — documentários, ficções, webséries, filmes experimentais, videoartes, obras instalativas, fotografias e exposições."
  />

  {Object.keys(categorias).length > 0 ? (
    Object.entries(categorias).map(([cat, { label, items }]) => (
      <section class="secao" aria-labelledby={`cat-${cat}`}>
        <div class="section-heading">
          <h2 id={`cat-${cat}`}>{label}</h2>
        </div>
        <div class="grade-portfolio">
          {items.map((p) => (
            <article class="card-projeto">
              {p.data.imagem ? (
                <img src={p.data.imagem} alt={p.data.imagemAlt || p.data.titulo} />
              ) : (
                <div style="height:200px;background:var(--ouv-surface);display:flex;align-items:center;justify-content:center;color:var(--ouv-text-mute);font-family:var(--ouv-font-display);font-size:1.5rem;" aria-hidden="true">
                  {p.data.titulo}
                </div>
              )}
              <div class="card-projeto-info">
                <h3>{p.data.titulo}</h3>
                {!isPlaceholder(p.data.cliente) && (
                  <p class="cliente">{p.data.cliente}</p>
                )}
                {(!isPlaceholder(p.data.tipo) || !isPlaceholder(p.data.ano)) && (
                  <p class="meta">
                    {!isPlaceholder(p.data.tipo) && <span>{p.data.tipo}</span>}
                    {!isPlaceholder(p.data.ano) && <span>{p.data.ano}</span>}
                  </p>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>
    ))
  ) : (
    <section class="secao secao-alt" aria-labelledby="vazio">
      <div class="section-heading">
        <h2 id="vazio">Projetos em breve</h2>
        <p>Estamos organizando nosso portfólio. Em breve você poderá conferir aqui os projetos realizados pela Ouver.</p>
      </div>
    </section>
  )}

  <section class="secao-conversao" aria-labelledby="conv-port">
    <h2 id="conv-port">Quer seu projeto aqui?</h2>
    <p>Conte sobre sua obra e como podemos torná-la acessível.</p>
    <a href="/orcamento" class="botao botao-primario">Solicitar orçamento</a>
  </section>
</Base>