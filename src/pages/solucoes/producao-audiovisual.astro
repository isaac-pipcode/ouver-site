---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
---
<Base titulo="Produção Audiovisual" descricao="Produção de vídeos com acessibilidade desde a concepção: materiais educativos, institucionais e conteúdo sob demanda.">
  <Hero
    titulo="Produção Audiovisual"
    subtitulo="Precisa produzir um vídeo? Fazemos com acessibilidade desde a concepção — não como remendo no final, mas como parte do processo criativo."
    ctas={[{ rotulo: 'Solicitar orçamento', href: '/orcamento', primario: true }]}
  />

  <section class="secao secao-alt" aria-labelledby="sob-demanda">
    <div class="section-heading">
      <h2 id="sob-demanda">Produção sob demanda</h2>
    </div>
    <p style="max-width:40rem;margin:0 auto var(--espaco-lg);">Produzimos vídeos institucionais, conteúdos para redes sociais, materiais de divulgação e obras audiovisuais com acessibilidade pensada desde o roteiro:</p>
    <ul class="lista-contextos" style="max-width: 40rem;margin:0 auto;">
      <li>Roteiro que prevê pausas para audiodescrição</li>
      <li>Enquadramentos que facilitam a janela de Libras</li>
      <li>Legendas em texto real desde a captação</li>
      <li>Controles de áudio e vídeo acessíveis</li>
    </ul>
  </section>

  <section class="secao-destaque" aria-labelledby="educativos">
    <h2 id="educativos">Materiais educativos</h2>
    <p>Conteúdo educacional acessível para cursos, treinamentos e plataformas de EAD — com audiodescrição, legendas descritivas, Libras e transcrição textual completa.</p>
  </section>

  <section class="secao-conversao" aria-labelledby="conv-prod">
    <h2 id="conv-prod">Quer produzir um conteúdo acessível?</h2>
    <p>Converse conosco sobre seu projeto.</p>
    <a href="/orcamento" class="botao botao-primario">Solicitar orçamento</a>
  </section>
</Base>