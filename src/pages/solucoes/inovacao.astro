---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
---
<Base titulo="Inovação" descricao="Formação, pesquisa e soluções digitais para fazer o campo da acessibilidade avançar.">
  <Hero
    titulo="Inovação"
    subtitulo="A Ouver não apenas faz acessibilidade — faz o campo avançar. Formamos profissionais, pesquisamos e desenvolvemos tecnologia para que a acessibilidade audiovisual evolua."
    ctas={[{ rotulo: 'Solicitar orçamento', href: '/orcamento', primario: true }]}
  />

  <section class="secao secao-alt" aria-labelledby="formacao">
    <div class="section-heading">
      <h2 id="formacao">Formação</h2>
      <p>Capacitação em acessibilidade audiovisual para profissionais, empresas e instituições de ensino.</p>
    </div>
    <p style="text-align:center;max-width:30rem;margin:0 auto;color:var(--cor-terra-escuro);">[Inserir dados reais: cursos oferecidos, carga horária, público-alvo, depoimentos.]</p>
  </section>

  <section class="secao" aria-labelledby="pesquisa">
    <div class="section-heading">
      <h2 id="pesquisa">Pesquisa</h2>
      <p>Com vínculo com a pesquisa acadêmica do campo, participamos de estudos e desenvolvemos conhecimento sobre acessibilidade audiovisual.</p>
    </div>
    <p style="text-align:center;max-width:30rem;margin:0 auto;color:var(--cor-terra-escuro);">[Inserir dados reais: publicações, parcerias acadêmicas, projetos de pesquisa.]</p>
  </section>

  <section class="secao-destaque" aria-labelledby="solucoes-digitais">
    <h2 id="solucoes-digitais">Soluções digitais</h2>
    <p>Desenvolvemos ferramentas e plataformas que facilitam a produção e distribuição de conteúdo acessível.</p>
    <p style="margin-top:1rem;">[Inserir dados reais: ferramentas desenvolvidas, projetos, tecnologias.]</p>
  </section>

  <section class="secao-conversao" aria-labelledby="conv-inov">
    <h2 id="conv-inov">Quer inovar com a gente?</h2>
    <p>Entre em contato para saber mais.</p>
    <a href="/orcamento" class="botao botao-primario">Solicitar orçamento</a>
  </section>
</Base>